+<!-- LEAD MAGNET -->
+<section class="section" style="background:linear-gradient(160deg,rgba(196,217,200,.22) 0%,var(--cream) 60%);padding:80px 40px;">
+  <div style="max-width:720px;margin:0 auto;text-align:center;">
+    <div class="section-label">Free For Breeders</div>
+    <h2 style="font-family:var(--serif);font-size:32px;line-height:1.2;color:var(--ink);margin-bottom:16px;">Ever had a buyer back out with nothing in writing?</h2>
+    <p style="font-size:16px;color:var(--ink-3);line-height:1.7;margin-bottom:32px;max-width:560px;margin-left:auto;margin-right:auto;">
+      Get the Puppy Buyer Agreement &amp; Deposit Terms template every breeder needs before their first difficult buyer &mdash; free, right now, no strings attached.
+    </p>
+
+    <form id="leadMagnetForm" style="display:flex;gap:10px;max-width:440px;margin:0 auto;flex-wrap:wrap;justify-content:center;">
+      <input type="email" id="leadMagnetEmail" required placeholder="you@yourkennel.com"
+        style="flex:1;min-width:220px;padding:14px 18px;border-radius:10px;border:1px solid rgba(230,223,212,.9);font-size:15px;font-family:inherit;background:var(--white);color:var(--ink);">
+      <button type="submit" id="leadMagnetBtn" class="pricing-cta" style="background:linear-gradient(135deg,var(--forest-l),var(--forest));color:#fff;margin-bottom:0;white-space:nowrap;">Send me the template →</button>
+    </form>
+    <div id="leadMagnetMsg" style="margin-top:14px;font-size:13.5px;color:var(--ink-4);min-height:18px;"></div>
+
+    <!-- Step 2: optional qualification, shown after email capture -->
+    <div id="leadQualify" style="display:none;max-width:440px;margin:20px auto 0;text-align:left;background:var(--white);border:1px solid rgba(230,223,212,.9);border-radius:14px;padding:22px 24px;">
+      <div style="font-size:14px;font-weight:700;color:var(--ink);margin-bottom:4px;">Two quick questions? <span style="font-weight:400;color:var(--ink-4);">(optional)</span></div>
